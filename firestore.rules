rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }
    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }
    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId && request.resource.data.uid == userId;
      allow delete: if signedIn() && request.auth.uid == userId;
    }
    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /chats/{chatId} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.members;
      }
      function isGroup() { return resource.data.get('isGroup', false) == true; }
      function isAdmin() {
        return signedIn() && request.auth.uid in resource.data.get('admins', []);
      }
      function otherMemberUid() {
        return resource.data.members[0] == request.auth.uid
          ? resource.data.members[1] : resource.data.members[0];
      }
      function senderIsNotBlocked() {
        return isGroup() || !(otherMemberUid() in resource.data.get('blockedBy', []));
      }
      function blockStateCanOnlyChangeOwnBlock() {
        let oldBlocked = resource.data.get('blockedBy', []);
        let newBlocked = request.resource.data.get('blockedBy', []);
        return isGroup() || (newBlocked is list
          && newBlocked.hasOnly(oldBlocked.concat([request.auth.uid]))
          && (!(otherMemberUid() in oldBlocked) || otherMemberUid() in newBlocked));
      }
      function membershipChangeAllowed() {
        let oldMembers = resource.data.members;
        let newMembers = request.resource.data.members;
        return isGroup() && newMembers is list && newMembers.size() >= 2
          && newMembers.size() <= 50
          && (isAdmin() ||
            (request.auth.uid in oldMembers
              && !(request.auth.uid in newMembers)
              && newMembers.size() == oldMembers.size() - 1
              && oldMembers.hasAll(newMembers)));
      }

      // Keep privileged chat metadata immutable from ordinary member updates.
      function chatUpdateFieldsAllowed() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'members', 'memberNames', 'title', 'avatarUrl',
          'lastMessage', 'updatedAt', 'typingAt',
          'mutedFor', 'hiddenFor', 'blockedBy'
        ]);
      }

      function groupMetadataChangeAllowed() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return (!changed.hasAny(['title']) ||
            (isGroup() && isAdmin()
              && request.resource.data.get('title', '') is string
              && request.resource.data.get('title', '').size() > 0
              && request.resource.data.get('title', '').size() <= 40))
          && (!changed.hasAny(['avatarUrl']) ||
            (isGroup() && isAdmin()
              && request.resource.data.get('avatarUrl', '') is string
              && request.resource.data.get('avatarUrl', '').size() <= 2048))
          && (!changed.hasAny(['memberNames']) || !isGroup() || isAdmin());
      }

      function ownArrayEntryChangeAllowed(oldValues, newValues) {
        return oldValues is list && newValues is list
          && oldValues.hasOnly(newValues.concat([request.auth.uid]))
          && newValues.hasOnly(oldValues.concat([request.auth.uid]));
      }

      function userArrayFieldsChangeAllowed() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return (!changed.hasAny(['mutedFor']) ||
            ownArrayEntryChangeAllowed(
              resource.data.get('mutedFor', []),
              request.resource.data.get('mutedFor', [])
            ))
          && (!changed.hasAny(['hiddenFor']) ||
            ownArrayEntryChangeAllowed(
              resource.data.get('hiddenFor', []),
              request.resource.data.get('hiddenFor', [])
            ));
      }

      function typingFieldChangeAllowed() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let oldTyping = resource.data.get('typingAt', {});
        let newTyping = request.resource.data.get('typingAt', {});
        return !changed.hasAny(['typingAt']) ||
          (oldTyping is map && newTyping is map
            && newTyping.diff(oldTyping).affectedKeys().hasOnly([request.auth.uid]));
      }

      function blockFieldChangeAllowed() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return !changed.hasAny(['blockedBy']) ||
          (!isGroup() && blockStateCanOnlyChangeOwnBlock());
      }

      function lastMessageChangeAllowed() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return !changed.hasAny(['lastMessage']) ||
          (senderIsNotBlocked()
            && request.resource.data.get('lastMessage', '') is string
            && request.resource.data.get('lastMessage', '').size() <= 5000);
      }

      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 50
        && (
          (request.resource.data.get('isGroup', false) == true
            && request.resource.data.createdBy == request.auth.uid
            && request.auth.uid in request.resource.data.get('admins', []))
          || (request.resource.data.get('isGroup', false) != true
            && request.resource.data.members.size() == 2)
        );
      allow read: if isMember();
      allow update: if isMember()
        && chatUpdateFieldsAllowed()
        && (request.resource.data.members == resource.data.members || membershipChangeAllowed())
        && groupMetadataChangeAllowed()
        && userArrayFieldsChangeAllowed()
        && typingFieldChangeAllowed()
        && blockFieldChangeAllowed()
        && lastMessageChangeAllowed();
      allow delete: if false;

      match /messages/{messageId} {
        function chatExistsAndUserIsMember() {
          return signedIn() && request.auth.uid in get(
            /databases/$(database)/documents/chats/$(chatId)).data.members;
        }
        function messageChatIsGroup() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data.get('isGroup', false) == true;
        }
        function messageSenderIsNotBlocked() {
          let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
          let members = chat.members;
          let otherUid = members[0] == request.auth.uid ? members[1] : members[0];
          return messageChatIsGroup() || !(otherUid in chat.get('blockedBy', []));
        }
        allow read: if chatExistsAndUserIsMember();
        allow create: if chatExistsAndUserIsMember()
          && messageSenderIsNotBlocked()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.get('text', '') is string
          && request.resource.data.get('text', '').size() <= 5000
          && request.resource.data.get('mediaUrl', '') is string
          && request.resource.data.get('mediaType', '') in ['', 'image', 'video'];
        allow update: if chatExistsAndUserIsMember() && (
          (resource.data.senderId != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['deliveredAt', 'readAt']))
          || (resource.data.senderId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['text', 'edited', 'editedAt'])
            && request.resource.data.get('text', '').size() <= 5000)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            && request.resource.data.get('reactions', {}) is map)
        );
        allow delete: if chatExistsAndUserIsMember()
          && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
{
  "name": "neurogram-firebase-rules-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test:firestore-rules": "firebase emulators:exec --only firestore --project demo-neurogram-rules \"node --test tests/firestore.rules.test.mjs\"",
    "test:firebase-rules": "firebase emulators:exec --only firestore,storage --project demo-neurogram-rules \"node --test --test-concurrency=1 tests/*.rules.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.2",
    "firebase-tools": "^13.24.1"
  }
}
